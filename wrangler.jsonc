{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sklypolyginimas",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-19",
  "account_id": "59cf79e5a4e2dd1a9a5c3181684c43d7",
  "workers_dev": true,
  "preview_urls": false,

  // Static site built by `npm run build`
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },

  // Cloudflare Email Service – sends lead notifications to ADMIN_EMAIL
  "send_email": [{ "name": "EMAIL" }],

  // LeadHub decides whose contacts and photos the site shows and where client leads go.
  // The matching secret is the Worker secret LEADHUB_SECRET.
  "services": [{ "binding": "LEADHUB", "service": "leadhub" }],

  // Lead storage
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sklypolyginimas-leads",
      "database_id": "3635fc68-2020-4758-9a20-6c1d5dd9dc74",
      "migrations_dir": "migrations"
    }
  ],

  // Custom domains sklypolyginimas.lt and www.sklypolyginimas.lt are attached in the dashboard / API
  // (Workers → sklypolyginimas → Domains & Routes), so deploys don't need zone permissions.

  "vars": {
    "ADMIN_EMAIL": "marek.cernevic@gmail.com",
    // Sender must be on a domain onboarded to Email Sending; the fallback is used automatically if the first one fails
    "EMAIL_FROM": "uzklausa@sklypolyginimas.lt",
    "EMAIL_FROM_FALLBACK": "uzklausa@drenazoirengimas.lt",
    "SITE_ORIGIN": "https://sklypolyginimas.lt",
    "ALLOWED_ORIGINS": "https://sklypolyginimas.lt,https://www.sklypolyginimas.lt,https://sklypolyginimas.baier-f.workers.dev",
    "LEADS_ENABLED": "true",
    // robots.txt + noindex header (workers.dev is always noindex)
    "SEO_INDEXABLE": "true",
    "GA_MEASUREMENT_ID": "G-TDK1DCZ6MP",
    "LEADHUB_SITE_KEY": "sklypolyginimas"
  },

  "observability": { "enabled": true }
  // Secret: TURNSTILE_SECRET_KEY (set). Public site key: GitHub Actions variable TURNSTILE_SITE_KEY
}
